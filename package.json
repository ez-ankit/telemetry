{
  "name": "telemetry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise application monitoring and user activity analytics",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @telemetry/web",
    "build": "npm run build -w @telemetry/web",
    "start": "npm run start -w @telemetry/web",
    "lint": "npm run lint -w @telemetry/web",
    "typecheck": "npm run typecheck -w @telemetry/web",
    "clean": "turbo run clean"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
